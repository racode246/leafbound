# Biome checks these with LF line endings (biome.json), so keep them LF
# in Windows checkouts too, whatever core.autocrlf says.
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf

# Signed test payload (e2e/fixtures/updater): the signature covers the exact bytes.
*.bin  binary
