{
  "name": "leafbound",
  "version": "0.3.0",
  "description": "A calm, open-source EPUB reader for Windows.",
  "license": "MIT",
  "author": "racode246",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint --error-on-warnings",
    "tauri": "tauri",
    "test": "vitest run",
    "e2e": "npm run e2e:mock && npm run e2e:app",
    "e2e:mock": "playwright test -c e2e/playwright.config.ts --project=mock",
    "e2e:app": "playwright test -c e2e/playwright.config.ts --project=app --workers=1",
    "e2e:live": "playwright test -c e2e/playwright.config.ts --project=live --workers=1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "epubjs": "^0.3.93",
    "lucide-react": "1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
